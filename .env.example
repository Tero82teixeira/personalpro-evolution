VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Usado apenas por rotas serverless/backend.
# Pode repetir a URL do Supabase acima no ambiente da Vercel.
SUPABASE_URL=

# Configure apenas no servidor/Vercel. Nunca use no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Configure esta chave apenas no servidor/Vercel em Environment Variables.
# Nunca coloque chave real da OpenAI no frontend.
OPENAI_API_KEY=
